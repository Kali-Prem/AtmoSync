# ==============================================================================
# Dockerfile for ATMOSYNC FastAPI Backend (SIH-26082)
# Python 3.10 Slim Runtime
# ==============================================================================
FROM python:3.10-slim

WORKDIR /app

# Install system dependencies for networking and building C extensions if needed
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency requirements
COPY apps/api/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r ./requirements.txt

# Copy application source code and configurations
COPY apps ./apps
COPY database ./database
COPY services ./services
COPY scientific ./scientific
COPY ml ./ml
COPY configs ./configs
COPY scripts ./scripts
COPY pytest.ini ./pytest.ini

# Expose FastAPI listening port
EXPOSE 8000

ENV PYTHONPATH=/app
ENV ENVIRONMENT=production
ENV API_HOST=0.0.0.0
ENV API_PORT=8000

# Healthcheck probe
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Launch uvicorn ASGI server
CMD ["uvicorn", "apps.api.src.main:app", "--host", "0.0.0.0", "--port", "8000"]
