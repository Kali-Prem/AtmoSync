# ==============================================================================
# ATMOSYNC — Environment Configuration Template
# DO NOT COMMIT SENSITIVE SECRETS OR REAL CREDENTIALS TO VERSION CONTROL
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO
APP_NAME="ATMOSYNC"
API_V1_STR="/api/v1"

# Server Host & Port
API_HOST=0.0.0.0
API_PORT=8000
# Allowed CORS origins for frontend client.
# Format: JSON array string '["https://your-frontend.onrender.com", "http://localhost:3000"]'
# or comma-separated string "https://your-frontend.onrender.com,http://localhost:3000".
ALLOWED_CORS_ORIGINS='["http://localhost:3000", "http://127.0.0.1:3000"]'

# Database Configuration
# In local development without Postgres, SQLite is supported as fallback:
# DATABASE_URL=sqlite:///./data/vayudrishti.db
# In containerized/production deployment:
DATABASE_URL=postgresql+psycopg://vayudrishti:vayudrishti_password@localhost:5432/vayudrishti_db
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# In-Memory Cache & Message Broker
REDIS_URL=redis://localhost:6379/0

# External Data Source Providers (Verified in Research Phase)
WEATHER_PROVIDER=open-meteo
AIR_QUALITY_PROVIDER=openaq
SATELLITE_FIRE_PROVIDER=nasa-firms
CHEMICAL_PRIOR_PROVIDER=cams-global

# API Credentials (Register for free developer keys as documented in DOC-RES-002)
# NASA FIRMS: https://firms.modaps.eosdis.nasa.gov/api/
NASA_FIRMS_MAP_KEY=placeholder_nasa_firms_key_here
# OpenAQ v3 API: https://openaq.org
OPENAQ_API_KEY=placeholder_openaq_key_here
# Copernicus CDS (Optional, for ERA5 training downloads):
CDSAPI_URL=https://cds.climate.copernicus.eu/api/v2
CDSAPI_KEY=placeholder_cds_uid_key_here

# Storage Backend
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./data
# For cloud deployments:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_S3_BUCKET_NAME=vayudrishti-forecast-archive
# AWS_REGION=ap-south-1

# Scientific & ML Modeling Configuration
PHYSICAL_DIAGNOSTICS_ENABLED=True
PLUME_DISPERSION_ENABLED=True
ML_MODEL_BACKEND=lightgbm-direct
FORECAST_HORIZON_HOURS=72
INFERENCE_BATCH_SIZE=40

# Regulatory Standard
AQI_STANDARD=CPCB_NAQI_2014
